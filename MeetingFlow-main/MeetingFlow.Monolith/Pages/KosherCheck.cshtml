@page
@model MeetingFlow.Monolith.Pages.KosherCheckModel
@{
    ViewData["Title"] = "Kosher Checker";
}

<div class="kosher-page">
    <header class="kosher-hero">
        <p class="eyebrow">AI dish assessment</p>
        <h1>Is this dish kosher?</h1>
        <p>
            Add up to 10 dish descriptions. The AI will classify each one and explain the result.
        </p>
    </header>

    <section class="card kosher-form-card" aria-labelledby="kosher-form-title">
        <h2 id="kosher-form-title">Dishes to check</h2>
        <form method="post" asp-page-handler="Check" id="kosher-check-form">
            <div id="dish-fields">
                <div class="dish-row">
                    <div class="field dish-input">
                        <label for="dish-1">Dish 1</label>
                        <input id="dish-1"
                               name="Dishes"
                               type="text"
                               maxlength="500"
                               required
                               autocomplete="off"
                               placeholder="Example: beef burger with plant-based cheese" />
                    </div>
                    <button type="button"
                            class="remove-dish"
                            aria-label="Remove dish 1"
                            hidden>
                        Remove
                    </button>
                </div>
            </div>

            <div class="kosher-actions">
                <button type="button" id="add-dish" class="secondary-button">Add dish</button>
                <button type="submit" class="primary-button">Check kosher status</button>
            </div>

            <div id="kosher-loading" class="kosher-loading" role="status" aria-live="polite" hidden>
                <span class="loading-spinner" aria-hidden="true"></span>
                <span>The AI is consulting a rabbi about your dishes…</span>
            </div>
            <div id="kosher-error" class="error-box" role="alert" hidden></div>
        </form>
    </section>

    <section id="kosher-results" aria-labelledby="kosher-results-title" hidden>
        <h2 id="kosher-results-title">Assessment</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Dish</th>
                        <th scope="col">Status</th>
                        <th scope="col">Explanation</th>
                    </tr>
                </thead>
                <tbody id="kosher-results-body"></tbody>
            </table>
        </div>
        <p class="kosher-disclaimer">
            This is an AI-generated general assessment, not kosher certification or rabbinic guidance.
        </p>
    </section>

    <section id="kosher-history" aria-labelledby="kosher-history-title" hidden>
        <h2 id="kosher-history-title">Previous checks</h2>
        <div id="kosher-history-list"></div>
    </section>
</div>

<script src="~/js/kosher-check.js" asp-append-version="true"></script>
